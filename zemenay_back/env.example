# ==========================================
# LOCAL POSTGRESQL CONFIGURATION (ZEMENAY)
# ==========================================

# Local PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:dere2010@localhost:5432/zemenay

# Supabase Configuration (Keep for compatibility - will use local DB)
# Note: Since your code uses Supabase client API, you have two options:
# Option 1: Set up PostgREST locally (recommended for full compatibility)
# Option 2: Use direct PostgreSQL connection (requires code changes)

# For now, use dummy values - your app will connect via DATABASE_URL
SUPABASE_URL=http://localhost:3000
SUPABASE_KEY=dummy_key_for_local_dev
SUPABASE_SERVICE_KEY=dummy_service_key_for_local_dev

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_strong_jwt_secret_change_this_in_production
JWT_EXPIRES_IN=1d