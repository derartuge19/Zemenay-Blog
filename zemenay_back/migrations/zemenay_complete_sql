-- Complete Database Setup for Zemenay PostgreSQL Database
-- Run this script on your local "zemenay" database

-- Enable UUID extension
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS "pgcrypto";

-- Drop existing tables if needed (uncomment if you want fresh install)
-- DROP TABLE IF EXISTS comments CASCADE;
